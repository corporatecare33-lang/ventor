APP_NAME=LeatherX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (production). For a quick local try you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leatherx
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Product / banner / blog images (Spatie Media Library). Run `php artisan storage:link`.
MEDIA_DISK=public
QUEUE_CONNECTION=database

# File cache is the fastest option on shared hosting. Use redis if your host provides it.
CACHE_STORE=file
CACHE_PREFIX=leatherx

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Order confirmation emails (use your cPanel email account SMTP details).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First super admin, created by `php artisan db:seed`. If ADMIN_PASSWORD is empty
# a random password is generated and printed once in the terminal.
ADMIN_NAME="LeatherX Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Third-party integrations — NOT connected yet (placeholders only).
# Payments, delivery and SMS currently run as manual, admin-controlled flows.
# Fill these in only when the real integration code is added (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# NAGAD_MERCHANT_ID=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# SMS_API_KEY=
# SMS_SENDER_ID=

VITE_APP_NAME="${APP_NAME}"
